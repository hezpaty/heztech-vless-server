# Single container runs: nginx (TLS + reverse proxy) AND node app.js
# nginx listens on 8080 (ALB target), node app binds 127.0.0.1:8081 internally
FROM node:18-alpine

RUN apk add --no-cache nginx certbot curl ca-certificates tzdata

WORKDIR /app

# Install deps (covers the dynamic ensureModule('ws'))
COPY package.json ./
RUN npm install --omit=dev

COPY app.js .
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && mkdir -p /etc/letsencrypt/live /var/www/certbot

ENV NODE_ENV=production
ENV APP_PORT=8081
ENV NGINX_PORT=8080
ENV DOMAIN=hezpaty.hezz.dpdns.org

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
